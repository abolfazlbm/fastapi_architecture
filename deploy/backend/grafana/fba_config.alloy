// ============================================================================
// Grafana Alloy configuration file
// Alloy is Grafana's observability data collector (formerly Grafana Agent)
// Official documentation: https://grafana.com/docs/alloy/latest/
//
//Data flow direction:
// Application -> OTLP Receiver -> Batch Processor -> Exporters -> Backend Storage
// - Logs -> Loki
// - Metrics -> Prometheus
// - Traces -> Tempo
// ============================================================================

// OTLP receiver configuration
// Support receiving logs, indicators and link tracking data at the same time
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs    = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// Batch processor configuration
// Combine multiple telemetry data items into batches to improve transmission efficiency
otelcol.processor.batch "default" {
  output {
    logs    = [otelcol.exporter.loki.default.input]
    metrics = [otelcol.exporter.prometheus.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Loki exporter configuration
// Send log data to Grafana Loki
otelcol.exporter.loki "default" {
  forward_to = [loki.write.loki_server.receiver]
}

// Loki writing component
// Responsible for pushing log data to the Loki server
loki.write "loki_server" {
  endpoint {
    url = "http://fba_loki:3100/loki/api/v1/push"
  }
}

// Prometheus exporter configuration
// Send metric data to Prometheus
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.prom_server.receiver]
}

// Prometheus remote writing component
// Responsible for pushing indicator data to the Prometheus server
prometheus.remote_write "prom_server" {
  endpoint {
    url = "http://fba_prometheus:9090/api/v1/write"
  }
}

// Prometheus own indicator capture
// Monitor the running status of the Prometheus server itself
prometheus.scrape "prometheus" {
	targets = [{
		__address__ = "fba_prometheus:9090",
	}]
	forward_to      = [prometheus.remote_write.prom_server.receiver]
	job_name        = "fba_prometheus"
	scrape_interval = "15s"
}

// FastAPI backend service indicator capture
// Monitor the performance and business indicators of FastAPI applications
prometheus.scrape "fba_server" {
	targets = [{
		__address__ = "fba_server:8001",
	}]
	forward_to      = [prometheus.remote_write.prom_server.receiver]
	job_name        = "fba_server"
	scrape_interval = "5s"
	scrape_timeout  = "5s"
}

// Granian server indicator capture
// Monitor the performance indicators of the Granian ASGI server
prometheus.scrape "fba_granian" {
	targets = [{
		__address__ = "fba_server:8002",
	}]
	forward_to      = [prometheus.remote_write.prom_server.receiver]
	job_name        = "fba_granian"
	scrape_interval = "5s"
	scrape_timeout  = "5s"
}

// Celery Exporter indicator capture
// Monitor the running status of Celery asynchronous task queue
prometheus.scrape "fba_celery_exporter" {
	targets = [{
		__address__ = "fba_celery_exporter:9808",
	}]
	forward_to      = [prometheus.remote_write.prom_server.receiver]
	job_name        = "fba_celery_exporter"
	scrape_interval = "15s"
	scrape_timeout  = "15s"
}

// Tempo exporter configuration
// Send link tracking data to Grafana Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "fba_tempo:4317"
    tls {
        insecure             = true
        insecure_skip_verify = true
    }
  }
}
